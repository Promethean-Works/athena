{
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "MAX_MCP_OUTPUT_TOKENS": "20000"
  },
  "claudeMdExcludes": [
    "**/.venv/**/CLAUDE.md",
    "**/.venv/**/AGENTS.md",
    "**/node_modules/**/CLAUDE.md",
    "**/node_modules/**/AGENTS.md"
  ],
  "enabledMcpjsonServers": [
    "shadcn",
    "next-devtools",
    "playwright",
    "context7"
  ],
  "permissions": {
    "allow": [
      "mcp__shadcn",
      "mcp__next-devtools",
      "mcp__context7",
      "Bash(pnpm dlx shadcn@latest *)",
      "Bash(pnpm install*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm build*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(uv sync*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run pyright*)",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_network_requests",
      "mcp__ccd_pr__get_status",
      "Bash(actionlint)",
      "Bash(actionlint -color)",
      "Bash(node scripts/agents-sync.mjs --check)",
      "Bash(shellcheck *)",
      "Bash(hermes skills list)",
      "Bash(opencode mcp list)",
      "Bash(npm view *)",
      "Bash(gh run watch *)",
      "Bash(hermes mcp list)",
      "Bash(node scripts/agents-setup.mjs --check*)",
      "Bash(node scripts/agents-setup.mjs --dry-run*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agents-setup.mjs\" --check --quiet"
          }
        ]
      }
    ]
  }
}
