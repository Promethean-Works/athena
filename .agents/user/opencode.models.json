{
  "$comment": "Opt-in (agents-setup.mjs --with-models): the maintainer's OpenCode provider and models, merged into ~/.config/opencode/opencode.json. The key comes from the KILOCODE_API_KEY environment variable, never from this file.",
  "provider": {
    "kilo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kilo Gateway",
      "options": {
        "baseURL": "https://api.kilo.ai/api/openrouter/v1",
        "apiKey": "{env:KILOCODE_API_KEY}"
      },
      "models": {
        "anthropic/claude-sonnet-4.6": { "name": "Claude Sonnet 4.6" },
        "anthropic/claude-opus-4.6": { "name": "Claude Opus 4.6" },
        "openai/gpt-5.4": { "name": "GPT-5.4" },
        "google/gemini-2.5-pro": { "name": "Gemini 2.5 Pro" }
      }
    }
  },
  "model": "kilo/kilo-auto/free",
  "small_model": "kilo/openai/gpt-5.4"
}
